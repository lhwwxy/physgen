# PhysGen 密钥配置（复制为 .env 后填写；.env 已被 .gitignore 排除）
#
# 默认：所有模块（planner/generator/auditor/repairer）共用一个 key，
# config.yaml 通过 ${PHYSGEN_API_KEY} 引用。
PHYSGEN_API_KEY=sk-your-api-key-here

# 多供应商（可选）：LLM/VLM 与视频生成不是同一家时，为不同供应商
# 各配一个变量，并在 config.yaml 对应模块的 api_key 里引用它，例如：
#   generator: { api_key: ${PHYSGEN_VIDEO_API_KEY}, ... }
#   planner:   { api_key: ${PHYSGEN_LLM_API_KEY},   ... }
# PHYSGEN_VIDEO_API_KEY=sk-your-video-vendor-key
# PHYSGEN_LLM_API_KEY=sk-your-llm-vendor-key
